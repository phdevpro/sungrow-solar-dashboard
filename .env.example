# Copy to .env and fill in your values from https://developer-api.isolarcloud.eu
# (Application menu -> your app: Appkey + Secret Key / Access Key)

# Regional gateway. EU: https://gateway.isolarcloud.eu
# Others: https://gateway.isolarcloud.com (China), https://gateway.isolarcloud.com.hk (International),
#         https://augateway.isolarcloud.com (Australia)
ISC_GATEWAY=https://gateway.isolarcloud.eu

ISC_APPKEY=your_appkey_here
ISC_ACCESS_KEY=your_secret_access_key_here

# Your iSolarCloud account (the one you use in the app/website)
ISC_USERNAME=you@example.com
ISC_PASSWORD=your_password
